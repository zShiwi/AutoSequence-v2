    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "plc",
    "automation",
    "awl",
    "kop",
    "ladder",
    "step7",
    "industrial"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "three": "^0.170.0"
  }
}
