{
  "name": "autosequence-v2",
  "version": "2.1.0",
  "description": "AutoSequence Web - herramienta de automatización industrial (PLC): definición de señales, reglas SI/ENTONCES, simulación temporal y generación de código AWL/KOP.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
